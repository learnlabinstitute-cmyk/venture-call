# GEMINI_API_KEY: Server-side Gemini API key (Express / Vercel Serverless Functions)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Client-Side Gemini API Key for Direct Browser-to-Google Multimodal Live WebSocket
# (Bypasses serverless function timeouts on Vercel)
# Use NEXT_PUBLIC_GEMINI_API_KEY for Next.js or VITE_GEMINI_API_KEY for Vite/React
NEXT_PUBLIC_GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

